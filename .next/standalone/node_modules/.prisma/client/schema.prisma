generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum KanaType {
  HIRAGANA
  KATAKANA
}

enum KanaKategori {
  BASIC
  DAKUTEN
  HANDAKUTEN
}

enum JlptLevel {
  N5
  N4
  N3
  N2
  N1
}

enum MateriType {
  KOTOBA
  KANJI
  GRAMMAR
}

// Master data karakter kana, dikelola admin lewat /admin/kana
model KanaChar {
  id        String       @id @default(cuid())
  karakter  String
  romaji    String
  jenis     KanaType
  kategori  KanaKategori @default(BASIC)
  createdAt DateTime     @default(now())

  @@unique([karakter, jenis])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  kotobaProgress  UserKotobaProgress[]
  kanjiProgress   UserKanjiProgress[]
  grammarProgress UserGrammarProgress[]
  kanaProgress    UserKanaProgress[]
  attempts        QuizAttempt[]
}

// Kotoba = kosakata, di-tag JLPT level + bab buku Minna no Nihongo
model Kotoba {
  id            String    @id @default(cuid())
  kanjiKana     String
  furigana      String?
  romaji        String?
  arti          String
  contohKalimat String?
  level         JlptLevel @default(N5)
  bab           Int?
  createdAt     DateTime  @default(now())
  createdBy     String

  progresses UserKotobaProgress[]
}

// Kanji tunggal dengan cara baca on'yomi/kun'yomi
model Kanji {
  id        String    @id @default(cuid())
  karakter  String
  onyomi    String?
  kunyomi   String?
  arti      String
  level     JlptLevel @default(N5)
  bab       Int?
  createdAt DateTime  @default(now())
  createdBy String

  progresses UserKanjiProgress[]
}

// Pola tata bahasa (grammar point)
model Grammar {
  id            String    @id @default(cuid())
  pola          String
  penjelasan    String
  contohKalimat String?
  arti          String?
  level         JlptLevel @default(N5)
  bab           Int?
  createdAt     DateTime  @default(now())
  createdBy     String

  progresses UserGrammarProgress[]
}

// --- Progress SRS berbasis FSRS (field mengikuti struktur Card dari ts-fsrs) ---
// state: 0=New 1=Learning 2=Review 3=Relearning

model UserKotobaProgress {
  id       String @id @default(cuid())
  userId   String
  kotobaId String
  user     User   @relation(fields: [userId], references: [id])
  kotoba   Kotoba @relation(fields: [kotobaId], references: [id])

  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0)
  scheduledDays Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0)
  lastReview    DateTime?

  @@unique([userId, kotobaId])
}

model UserKanjiProgress {
  id      String @id @default(cuid())
  userId  String
  kanjiId String
  user    User   @relation(fields: [userId], references: [id])
  kanji   Kanji  @relation(fields: [kanjiId], references: [id])

  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0)
  scheduledDays Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0)
  lastReview    DateTime?

  @@unique([userId, kanjiId])
}

model UserGrammarProgress {
  id        String  @id @default(cuid())
  userId    String
  grammarId String
  user      User    @relation(fields: [userId], references: [id])
  grammar   Grammar @relation(fields: [grammarId], references: [id])

  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0)
  scheduledDays Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0)
  lastReview    DateTime?

  @@unique([userId, grammarId])
}

// Progress belajar hiragana & katakana per karakter per user
model UserKanaProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  karakter  String
  jenis     KanaType
  benar     Int      @default(0)
  salah     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, karakter, jenis])
}

// Log tiap jawaban kuis (kotoba/kanji/grammar) -> dipakai untuk gap analysis per bab
model QuizAttempt {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  materiType MateriType
  refId      String
  bab        Int?
  level      JlptLevel
  benar      Boolean
  responseMs Int
  createdAt  DateTime   @default(now())

  @@index([userId, materiType, bab])
}
